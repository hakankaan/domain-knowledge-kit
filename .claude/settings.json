{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx tsx src/cli.ts list:*)",
      "Bash(npx tsx src/cli.ts show:*)",
      "Bash(npx tsx src/cli.ts summary:*)",
      "Bash(npx tsx src/cli.ts search:*)",
      "Bash(npx tsx src/cli.ts related:*)",
      "Bash(npx tsx src/cli.ts graph:*)",
      "Bash(npx tsx src/cli.ts locate:*)",
      "Bash(npx tsx src/cli.ts story:*)",
      "Bash(npx tsx src/cli.ts validate:*)",
      "Bash(npx tsx src/cli.ts stats:*)",
      "Bash(npx tsx src/cli.ts prime:*)",
      "Bash(dkk list:*)",
      "Bash(dkk show:*)",
      "Bash(dkk summary:*)",
      "Bash(dkk search:*)",
      "Bash(dkk related:*)",
      "Bash(dkk graph:*)",
      "Bash(dkk locate:*)",
      "Bash(dkk story:*)",
      "Bash(dkk validate:*)",
      "Bash(dkk stats:*)",
      "Bash(dkk prime:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm test)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/dkk/claude/hooks/session-start-prime.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/dkk/claude/hooks/pre-edit-block-generated.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/dkk/claude/hooks/post-edit-validate.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/dkk/claude/hooks/stop-validate.mjs\""
          }
        ]
      }
    ]
  }
}
